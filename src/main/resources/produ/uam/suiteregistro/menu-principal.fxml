<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="produ.uam.suiteregistro.controllers.PrincipalController">
  <children>
    <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <menus>
        <Menu text="Catálogo">
          <items>
            <MenuItem onAction="#onAbrirEstudiantes" text="Registro de Estudiantes" />
            <MenuItem onAction="#onAbrirPeliculas" text="Registro de Películas" />
          </items>
        </Menu>
        <Menu text="Desarrollador">
          <items>
            <MenuItem onAction="#onMostrarDesarrollador" text="Información del Desarrollador" />
          </items>
        </Menu>
        <Menu text="Sistema">
          <items>
            <MenuItem onAction="#onSalir" text="Cerrar Aplicación" />
          </items>
        </Menu>
      </menus>
    </MenuBar>

    <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="28.0">
      <children>
        <Label text="Suite de Registros">
          <font>
            <Font name="System Bold" size="20.0" />
          </font>
          <!-- El ContextMenu va dentro del Label -->
          <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem onAction="#onAbrirEstudiantes" text="Ir a Registro de Estudiantes" />
                <MenuItem onAction="#onAbrirPeliculas" text="Ir a Registro de Películas" />
                <SeparatorMenuItem />
                <MenuItem onAction="#onMostrarDesarrollador" text="Acerca del Desarrollador" />
                <MenuItem onAction="#onSalir" text="Salir" />
              </items>
            </ContextMenu>
          </contextMenu>
        </Label>
        <Label text="Haga clic derecho sobre el título para abrir el menú contextual." textFill="#666666" />
      </children>
    </VBox>
  </children>
</AnchorPane>